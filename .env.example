# Copy to .env.local and fill in. Never commit a filled-in copy:
# .gitignore excludes .env* except this file (docs/07-repo-standards.md §6).
#
# Every variable the project reads is listed here with a dummy value and a
# comment saying what it is for. Variables are added by the task that first
# reads them — see docs/09-cicd.md §4 for the full set.

# The site's absolute origin. Used for every canonical URL, hreflang alternate,
# Open Graph tag and sitemap entry (SRS M-03, I-08, X-01), so it must be
# absolute, with no trailing slash and no path.
#
# There is no default: the build fails if this is unset or malformed. A
# fallback would publish canonical URLs pointing at the wrong host instead.
#
# Local development: http://localhost:3000 is accepted (loopback only).
# Deployments: must be https on a real host.
NEXT_PUBLIC_SITE_URL=https://example.com

# Whether this host may be indexed by search engines (SRS X-06, T-321).
#
# Opt-in, and deliberately so: indexing is off unless this is exactly "true".
# Anything else — unset, empty, "TRUE", "1" — leaves it off.
#
# Separate from VERCEL_ENV on purpose. Vercel marks the interim *.vercel.app
# deployment as production, and while the two questions shared one flag that
# deployment would have published an indexable duplicate of the site. Set this
# to true only on the canonical custom domain (D1b, T-311).
SITE_INDEXABLE=false

# Contact form delivery (SRS C-04, C-05). Never commit real values: set them
# in the Vercel project's environment variables.
#
# Get an API key at https://resend.com. CONTACT_FROM_EMAIL must be on a domain
# verified with Resend — until this site has its own domain (D1), Resend's
# onboarding@resend.dev sender works for testing and delivers only to the
# account owner's address.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
